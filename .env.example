# PostgreSQL接続文字列 (Neonなどのマネージドサービスを推奨)
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Auth.js
# 生成方法: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
